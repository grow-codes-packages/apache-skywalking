{
  "request": {
    "method": "POST",
    "url": "http://apache-skywalking:12800/graphql",
    "body": {
      "query": "query($d:Duration!){queryTraceTagAutocompleteKeys(duration:$d)}",
      "variables": {
        "d": {
          "start": "2026-11-18 2040",
          "end": "2026-11-18 2115",
          "step": "MINUTE"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "data": {
        "queryTraceTagAutocompleteKeys": [
          "http.status_code",
          "run_id",
          "http.method"
        ]
      }
    }
  }
}
