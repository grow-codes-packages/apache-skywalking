{
  "request": {
    "method": "POST",
    "url": "http://apache-skywalking:12800/graphql",
    "body": {
      "query": "query($l:String){listServices(layer:$l){id name}}",
      "variables": {
        "l": "NO_SUCH_LAYER"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "data": {
        "listServices": []
      }
    }
  }
}
